{
  "service_id": "POST_MATRIC_STATE_SCHOLARSHIP",
  "service_name_en": "Post-Matric State Scholarship for SC/ST/OBC/EWS",
  "service_name_hi": "पोस्ट-मैट्रिक राज्य छात्रवृत्ति योजना (एससी/एसटी/ओबीसी/ईडब्ल्यूएस)",
  "rule_version": "2.0.0",
  "statutory_authority": "Department of Social Welfare & Empowerment",
  "required_fields": [
    "full_name",
    "date_of_birth",
    "annual_income",
    "marks_percentage",
    "category",
    "institution_name"
  ],
  "validation_rules": {
    "annual_income": {
      "type": "numeric",
      "max_limit": 250000,
      "message_hi": "पारिवारिक वार्षिक आय ₹2,50,000 से अधिक नहीं होनी चाहिए।",
      "message_en": "Annual family income must not exceed ₹2,50,000."
    },
    "marks_percentage": {
      "type": "numeric",
      "min_limit": 50.0,
      "max_limit": 100.0,
      "message_hi": "पिछली कक्षा में न्यूनतम 50% अंक अनिवार्य हैं।",
      "message_en": "Minimum 50% marks required in the qualifying exam."
    },
    "category": {
      "type": "enum",
      "allowed_values": ["SC", "ST", "OBC", "EWS"],
      "message_hi": "यह योजना केवल SC, ST, OBC एवं EWS वर्ग के विद्यार्थियों के लिए है।",
      "message_en": "This scheme is only for SC, ST, OBC and EWS categories."
    },
    "date_of_birth": {
      "type": "date",
      "format": "DD/MM/YYYY",
      "min_age_years": 15,
      "max_age_years": 35,
      "message_hi": "जन्म तिथि DD/MM/YYYY प्रारूप में और आयु 15 से 35 वर्ष के मध्य होनी चाहिए।",
      "message_en": "Date of birth must be DD/MM/YYYY format and age must be between 15 and 35 years."
    }
  },
  "conditional_benefits": {
    "tier_1_full_waiver": {
      "condition_categories": ["SC", "ST"],
      "max_income": 100000,
      "benefit_en": "100% Tuition Fee Waiver + ₹1,200/month Hosteller Maintenance Allowance",
      "benefit_hi": "100% शिक्षण शुल्क छूट + ₹1,200/माह छात्रावास भत्ता"
    },
    "tier_2_standard_waiver": {
      "condition_categories": ["SC", "ST", "OBC", "EWS"],
      "max_income": 250000,
      "benefit_en": "75% Tuition Fee Waiver + Annual Book Grant",
      "benefit_hi": "75% शिक्षण शुल्क छूट + वार्षिक पुस्तक अनुदान"
    }
  },
  "dag_graph": {
    "nodes": [
      {"id": "full_name", "type": "FIELD"},
      {"id": "date_of_birth", "type": "FIELD"},
      {"id": "annual_income", "type": "FIELD"},
      {"id": "marks_percentage", "type": "FIELD"},
      {"id": "category", "type": "FIELD"},
      {"id": "institution_name", "type": "FIELD"},
      {"id": "identity_completeness_check", "type": "RULE"},
      {"id": "age_eligibility_check", "type": "RULE"},
      {"id": "statutory_income_check", "type": "RULE"},
      {"id": "academic_merit_check", "type": "RULE"},
      {"id": "caste_quota_check", "type": "RULE"},
      {"id": "institution_validity_check", "type": "RULE"},
      {"id": "fee_waiver_tier_evaluation", "type": "DERIVED"},
      {"id": "overall_statutory_readiness", "type": "DECISION"}
    ],
    "edges": [
      ["full_name", "identity_completeness_check"],
      ["date_of_birth", "age_eligibility_check"],
      ["annual_income", "statutory_income_check"],
      ["annual_income", "fee_waiver_tier_evaluation"],
      ["marks_percentage", "academic_merit_check"],
      ["category", "caste_quota_check"],
      ["category", "fee_waiver_tier_evaluation"],
      ["institution_name", "institution_validity_check"],
      ["identity_completeness_check", "overall_statutory_readiness"],
      ["age_eligibility_check", "overall_statutory_readiness"],
      ["statutory_income_check", "overall_statutory_readiness"],
      ["academic_merit_check", "overall_statutory_readiness"],
      ["caste_quota_check", "overall_statutory_readiness"],
      ["institution_validity_check", "overall_statutory_readiness"],
      ["fee_waiver_tier_evaluation", "overall_statutory_readiness"]
    ]
  }
}
