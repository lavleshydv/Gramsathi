# ==============================================================================
# GramSathi Environment Configuration Template
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=3000

# PostgreSQL with PostGIS Connection String
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gramsathi?schema=public"

# Redis Cache & Queue
REDIS_URL="redis://localhost:6379"

# JWT Secret for Session Authentication
JWT_SECRET="replace-with-a-secure-random-64-character-secret-in-production"
JWT_EXPIRES_IN="7d"

# Google Gemini API Key (Multimodal Grievance & Scheme Assistance)
GEMINI_API_KEY="your-gemini-api-key-here"

# SMS Gateway (Fast2SMS / Gupshup / Twilio for Mobile OTP & Alerts)
SMS_GATEWAY_API_KEY="your-sms-gateway-key"
SMS_SENDER_ID="GRAMST"

# S3 / MinIO Cloud Storage (Grievance Photo Evidence & Documents)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="ap-south-1"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET_NAME="gramsathi-media"

# Public App URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_LOCALE="hi"
